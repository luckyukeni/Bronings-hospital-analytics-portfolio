{
  "name": "NHS Bronings",
  "dataColors": ["#005EB8", "#003087", "#41B6E6", "#768692", "#009639", "#FFB81C", "#DA291C", "#330072", "#00A499", "#AE2573"],
  "background": "#FFFFFF",
  "foreground": "#231F20",
  "tableAccent": "#005EB8",
  "good": "#009639",
  "neutral": "#FFB81C",
  "bad": "#DA291C",
  "textClasses": {
    "title":   { "fontFace": "Arial", "fontSize": 12, "color": "#003087" },
    "header":  { "fontFace": "Arial", "fontSize": 12, "color": "#003087" },
    "label":   { "fontFace": "Arial", "fontSize": 10, "color": "#425563" },
    "callout": { "fontFace": "Arial", "fontSize": 28, "color": "#003087" }
  },
  "visualStyles": {
    "page": { "*": { "background": [{ "color": { "solid": { "color": "#F0F4F5" } }, "transparency": 0 }] } },
    "*": { "*": {
      "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
      "border": [{ "show": true, "color": { "solid": { "color": "#E8EDEE" } }, "radius": 6 }]
    } }
  }
}
